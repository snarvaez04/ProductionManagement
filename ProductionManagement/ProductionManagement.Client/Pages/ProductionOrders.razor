@page "/production-orders"
@using ProductionManagement.Client.Services
@using ProductionManagement.Client.Validators
@using ProductionManagement.Shared.DTOs
@inject ProductionOrderApiClient productionOrderApi
@inject CoilApiClient coilApi
@inject ProductionEventApiClient productionEventApi
@inject QualityInspectionApiClient qualityInspectionAPi
@inject ISnackbar Snackbar

<PageTitle>
    SteelOps - Production Orders
</PageTitle>
<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h4">
                Production Orders
            </MudText>
            <MudText Color="Color.Secondary">
                Create and manage production orders.
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NewOrder">
            New Order
        </MudButton>
    </div>
    @if (_editing)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6">
                @(_editId.HasValue ? "Edit Order" : "New Order")
            </MudText>
            <MudForm @ref="_form" ValidationDelay="0">
                <MudGrid Class="mt-1">
                    @if (!_editId.HasValue)
                    {
                        <MudItem xs="12" sm="6">
                            <MudTextField Label="Order Number" @bind-Value="_orderNumber" Required="true" Immediate="true"/>
                        </MudItem>
                    }
                    <MudItem xs="12" sm="6">
                        <MudTextField Label="Customer" @bind-Value="_customer" Required="true" Immediate="true" DebounceInterval="500" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField Label="Product" @bind-Value="_product" Required="true" Immediate="true" DebounceInterval="500"/>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField Label="Steel Grade" @bind-Value="_grade" Required="true" Immediate="true" DebounceInterval="500"/>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="decimal" Label="Target Width" @bind-Value="_width" Required="true" Immediate="true" Validation="(decimal num) => FormValidators.ValidateNumber(num)"/>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="decimal" Label="Target Thickness" @bind-Value="_thickness" Required="true" Immediate="true" Validation="(decimal num) => FormValidators.ValidateNumber(num)"/>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="decimal" Label="Target Weight" @bind-Value="_weight" Required="true" Immediate="true" Validation="(decimal num) => FormValidators.ValidateNumber(num)"/>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="int" Label="Quantity" @bind-Value="_quantity" Required="true" Immediate="true" Validation="(int num) => FormValidators.ValidateNumber(num)"/>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker Label="Due Date" @bind-Date="_dueDate" Required="true" Immediate="true" Validation="(DateTime? date) => FormValidators.ValidateDate(date)"/>
                    </MudItem>
                </MudGrid>
                <div class="mt-4">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">
                        Save
                    </MudButton>
                    <MudButton Class="ml-2" OnClick="CancelEdit">
                        Cancel
                    </MudButton>
                </div>
            </MudForm>
        </MudPaper>
    }
    <MudPaper Class="pa-4">
        <MudTextField Label="Search" @bind-Value="_search" Class="mb-3" Clearable="true" />
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else {
        <MudTable Items="Filtered" Hover="true" Dense="true" Striped="true">
            <HeaderContent>
                <MudTh>
                    Order
                </MudTh>
                <MudTh>
                    Customer
                </MudTh>
                <MudTh>
                    Product
                </MudTh>
                <MudTh>
                    Status
                </MudTh>
                <MudTh>
                    Coils
                </MudTh>
                <MudTh>
                    Due
                </MudTh>
                <MudTh>
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudLink Href="@($"/production-orders/{context.Id}")">
                        @context.OrderNumber
                    </MudLink>
                </MudTd>
                <MudTd>
                    @context.CustomerName
                </MudTd>
                <MudTd>
                    @context.ProductCode
                </MudTd>
                <MudTd>
                    @context.Status
                </MudTd>
                <MudTd>
                    @context.CoilCount
                </MudTd>
                <MudTd>
                    @(context.DueDate?.ToString("d") ?? "-")
                </MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" OnClick="@(() => Edit(context))">Edit
                    </MudButton>
                    <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Id))">Delete
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>
</MudContainer>

@code
    {
    private IReadOnlyList<ProductionOrderListDto> _orders = [];
    private string _search = string.Empty;
    private bool _loading;
    private bool _editing;
    private int? _editId;
    private string _orderNumber = "", _customer = "", _product = "", _grade = "";
    private decimal _width, _thickness, _weight;
    private int _quantity;
    private DateTime? _dueDate;
    private IEnumerable<ProductionOrderListDto> Filtered => _orders.Where(x => string.IsNullOrWhiteSpace(_search) || $"{x.OrderNumber} {x.CustomerName} {x.ProductCode} {x.SteelGrade} {x.Status}".Contains(_search, StringComparison.OrdinalIgnoreCase));
    protected override Task OnInitializedAsync() => Load();
    private MudForm _form;

    private async Task Load()
    {
        _loading = true;
        try
        {
            _orders = await productionOrderApi.GetListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void NewOrder()
    {
        _editId = null;
        _orderNumber = _customer = _product = _grade = "";
        _width = _thickness = _weight = 0;
        _quantity = 0;
        _dueDate = null;
        _editing = true;
    }

    private void Edit(ProductionOrderListDto x)
    {
        _editId = x.Id;
        _orderNumber = x.OrderNumber;
        _customer = x.CustomerName;
        _product = x.ProductCode;
        _grade = x.SteelGrade;
        _width = x.TargetWidth;
        _thickness = x.TargetThickness;
        _weight = x.TargetWeight;
        _quantity = x.Quantity;
        _dueDate = x.DueDate;
        _editing = true;
    }

    private async Task Save()
    {
        try
        {
            await _form.ValidateAsync();

            if(!_form.IsValid)
                return;

            if (_editId is null) 
            {
                var productionOrder = new CreateProductionOrderRequest
                {
                    OrderNumber = _orderNumber,
                    CustomerName = _customer,
                    ProductCode = _product,
                    SteelGrade = _grade,
                    TargetWidth = _width,
                    TargetThickness = _thickness,
                    TargetWeight = _weight,
                    Quantity = _quantity,
                    DueDate = _dueDate
                };

                productionOrder.Id = await productionOrderApi.CreateAsync(productionOrder);

                var coilsList = await CreateCoils(productionOrder);

                var modifiedCoils = await ModifyCoils(coilsList, productionOrder);

                var coilInspectionResults = InspectCoils(modifiedCoils, productionOrder);

                await ReleaseOrHoldCoils(coilInspectionResults);
            }
            else 
                await productionOrderApi.UpdateAsync(_editId.Value, new UpdateProductionOrderRequest
                {
                    CustomerName = _customer, ProductCode = _product, SteelGrade = _grade, TargetWidth = _width, TargetThickness = _thickness, TargetWeight = _weight, Quantity = _quantity, DueDate = _dueDate
                });

            _editing = false;
            await Load();
            Snackbar.Add("Order saved.", Severity.Success);
        }
        catch(Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void CancelEdit() => _editing = false;

    private async Task Delete(int id)
    {
        try
        {
            await productionOrderApi.DeleteAsync(id);
            await Load();
            Snackbar.Add("Order deleted.", Severity.Success);
        }
        catch(Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task<List<CreateCoilRequest>> CreateCoils(CreateProductionOrderRequest productionOrder)
    {
        var createdCoils = new List<CreateCoilRequest>();

        for (int i = 0; i < productionOrder.Quantity; i++)
        {
            var coil = new CreateCoilRequest();
            coil.CoilNumber = $"Coil{i}-{productionOrder.Id}";
            coil.ProductionOrderId = productionOrder.Id;
            coil.SteelGrade = productionOrder.SteelGrade;
            coil.Thickness = productionOrder.TargetThickness;
            coil.Weight = productionOrder.TargetWeight;
            coil.Width = productionOrder.TargetWidth;
            coil.CurrentLocation = "";

            coil.Id =  await coilApi.CreateAsync(coil);
            createdCoils.Add(coil);
        }

        return createdCoils;
    }

    private async Task<List<CreateCoilRequest>> ModifyCoils(List<CreateCoilRequest> coilsList, CreateProductionOrderRequest productionOrder)
    {
        var coilToModify = coilsList.FirstOrDefault();
        var modificationPercentage = .15m;

        if (coilToModify != null)
        {
            coilToModify.Width += coilToModify.Width * modificationPercentage;

            var coilUpdateRequest = new UpdateCoilRequest() { Width = coilToModify.Width, Weight = coilToModify.Weight, Thickness = coilToModify.Thickness, CurrentLocation = "Mill"};
            await coilApi.UpdateAsync(coilToModify.Id, coilUpdateRequest);
        }

        return coilsList;
    }

    private List<CoilInspectionResults> InspectCoils(List<CreateCoilRequest> coilsList, CreateProductionOrderRequest productionOrder)
    {
        var inspectionResults = new List<CoilInspectionResults>();

        foreach (var coil in coilsList)
        {
            var threshold = .10m;
            var upperBoundWidthVariance = productionOrder.TargetWidth + (productionOrder.TargetWidth * threshold);
            var lowerBoundWidthVariance = productionOrder.TargetWidth - (productionOrder.TargetWidth * threshold);

            var upperBoundThicknessVariance = productionOrder.TargetThickness + (productionOrder.TargetThickness * threshold);
            var lowerBoundThicknessVariance = productionOrder.TargetThickness - (productionOrder.TargetThickness * threshold);

            var upperBoundWeightVariance = productionOrder.TargetWeight + (productionOrder.TargetWeight * threshold);
            var lowerBoundWeightVariance = productionOrder.TargetWeight - (productionOrder.TargetWeight * threshold);

            var widthFailed = coil.Width > upperBoundWidthVariance || coil.Width < lowerBoundWidthVariance;
            var thicknessFaild = coil.Thickness > upperBoundThicknessVariance || coil.Thickness < lowerBoundThicknessVariance;
            var weightFailed = coil.Weight > upperBoundWeightVariance || coil.Weight < lowerBoundWeightVariance;

            var coilInspectionResult = new CoilInspectionResults() { Coil = coil};

            if (widthFailed)
                coilInspectionResult.MeasurementsFailed.Add("Width");
            if(thicknessFaild)
                coilInspectionResult.MeasurementsFailed.Add("Thickness");
            if(weightFailed)
                coilInspectionResult.MeasurementsFailed.Add("Weight");

            if (!widthFailed && !thicknessFaild && !weightFailed)
            {
                coilInspectionResult.PassedInspection = true;
                inspectionResults.Add(coilInspectionResult);
            }
            else
            {
                coilInspectionResult.PassedInspection = false;
                inspectionResults.Add(coilInspectionResult);
            }
        }

        return inspectionResults;
    }

    private async Task ReleaseOrHoldCoils(List<CoilInspectionResults> coilInspectionResults)
    {
        foreach (var results in coilInspectionResults)
        {
            var passedInspectionNotes = $"Target production specifications met.";
            var failedInspectionNotes = $"Target specifications not met for {string.Join(",", results.MeasurementsFailed)}.";

            var inspection = new CreateQualityInspectionRequest()
            {
                CoilId = results.Coil.Id,
                Result = results.PassedInspection ? "Passed" : "Failed",
                ThicknessMeasured = results.Coil.Thickness,
                WeightMeasured = results.Coil.Weight,
                WidthMeasured = results.Coil.Width,
                Notes = results.PassedInspection ? passedInspectionNotes : failedInspectionNotes,
                InspectorName = "David Lee",
                SurfaceQuality = "Good"
            };

            await qualityInspectionAPi.CreateAsync(inspection);

            var eventType = results.PassedInspection ? "Quality Released" : "Quality Hold";
            var coilEventRequest = new CreateProductionEventRequest() 
            { 
                CoilId = results.Coil.Id, 
                EquipmentId = null, 
                EventDate = DateTime.Today, 
                EventType = eventType, 
                OperatorName = "Thomas Lee", 
                Notes = results.PassedInspection ? passedInspectionNotes : failedInspectionNotes
            };
            await productionEventApi.CreateAsync(coilEventRequest);
        }
    }
}
