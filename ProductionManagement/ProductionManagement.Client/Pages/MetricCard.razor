<MudPaper Elevation="1" Class="pa-4 metric-card">
    <div class="d-flex align-center justify-space-between">
        <MudAvatar Color="@Color" Variant="Variant.Outlined">
            <MudIcon Icon="@Icon" />
        </MudAvatar>
    </div>
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3">
        @Label
    </MudText>
    <MudText Typo="Typo.h4" Class="fw-bold">
        @Value
    </MudText>
</MudPaper>

@code
{
    [Parameter] public string Label
    {
        get;
        set;
    } = string.Empty;
    [Parameter] public string Value
    {
        get;
        set;
    } = string.Empty;
    [Parameter] public string Icon
    {
        get;
        set;
    } = string.Empty;
    [Parameter] public Color Color
    {
        get;
        set;
    }
}
