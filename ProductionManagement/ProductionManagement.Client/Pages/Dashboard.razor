@page "/"
@using ProductionManagement.Client.Services
@using ProductionManagement.Shared.DTOs
@using ProductionManagement.Shared.DTOs.DashboardSummary
@inject DashboardApiClient DashboardApi

<PageTitle>
    SteelOps - Dashboard
</PageTitle>
<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
    <MudText Typo="Typo.h4">
        Production Dashboard
    </MudText>
    <MudText Color="Color.Secondary" Class="mb-4">
        A simple view of current plant activity.
    </MudText>
    @if (_summary is null)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-4" />
        @if (_loaded)
        {
            <MudAlert Severity="Severity.Error">
                Could not load the dashboard.
            </MudAlert>
        }
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4">
                    <MudText Color="Color.Secondary">
                        Active Orders
                    </MudText>
                    <MudText Typo="Typo.h5">
                        @_summary.ActiveProductionOrders
                    </MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4">
                    <MudText Color="Color.Secondary">
                        Total Coils
                    </MudText>
                    <MudText Typo="Typo.h5">
                        @_summary.TotalCoils
                    </MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4">
                    <MudText Color="Color.Secondary">
                        Coils in Production
                    </MudText>
                    <MudText Typo="Typo.h5">
                        @_summary.CoilsInProduction
                    </MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4">
                    <MudText Color="Color.Secondary">
                        Coils On Hold
                    </MudText>
                    <MudText Typo="Typo.h5">
                        @_summary.CoilsOnHold
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
        <MudGrid Class="mt-2">
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6">
                        Quality
                    </MudText>
                    <MudText>
                        Open non-conformances: @_summary.OpenNonConformances
                    </MudText>
                    <MudText>
                        Resolved non-conformances: @_summary.ResolvedNonConformances
                    </MudText>
                    <MudText>
                        Closed non-conformances: @_summary.ClosedNonConformances
                    </MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6">
                        Equipment
                    </MudText>
                    <MudText>
                        Operational: @_summary.OperationalEquipment
                    </MudText>
                    <MudText>
                        Maintenance: @_summary.EquipmentInMaintenance
                    </MudText>
                    <MudText>
                        Down: @_summary.EquipmentDown
                    </MudText>
                    <MudText>
                        Offline: @_summary.EquipmentOffline
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
        <MudPaper Class="pa-4 mt-4">
            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.h6">
                    Recent Activity
                </MudText>
                <MudButton Href="/production-events" Size="Size.Small">
                    View Events
                </MudButton>
            </div>
            <MudTable Items="_activity" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>
                        Date
                    </MudTh>
                    <MudTh>
                        Coil
                    </MudTh>
                    <MudTh>
                        Event
                    </MudTh>
                    <MudTh>
                        Equipment
                    </MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        @context.EventDate.ToLocalTime().ToString("g")
                    </MudTd>
                    <MudTd>
                        @context.CoilNumber
                    </MudTd>
                    <MudTd>
                        @context.EventType
                    </MudTd>
                    <MudTd>
                        @(context.EquipmentNumber ?? "-")
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
</MudContainer>

@code
{
    private DashboardSummaryDto? _summary;
    private IReadOnlyList<DashboardRecentActivityDto> _activity = [];
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _summary = await DashboardApi.GetSummaryAsync();
            _activity = await DashboardApi.GetRecentActivityAsync(10);
        }
        catch
        {
        }
        finally
        {
            _loaded = true;
        }
    }
}
